{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "outDir": "./dist-server",
    "rootDir": "./server",  // ✓ fine
    "moduleResolution": "bundler", // add this
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["server/**/*.ts"]
}